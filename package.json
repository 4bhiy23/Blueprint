{
  "name": "blueprint",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "latest",
    "typescript": "^5"
  },
  "lint-staged": {
    "apps/api/**/*.{js,ts}": [
      "pnpm --filter @repo/api lint"
    ],
    "apps/web/**/*.{js,ts,tsx}": [
      "pnpm --filter @repo/web lint"
    ]
  }
}